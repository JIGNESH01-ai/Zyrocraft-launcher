<?xml version="1.0" encoding="utf-8"?>
<!-- About tab: launcher identity, version and the project link -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <net.kdt.pojavlaunch.prefs.ZyroActionPreference
        android:key="about_info"
        android:selectable="false"
        android:title="@string/zyro_brand_full"/>

    <net.kdt.pojavlaunch.prefs.ZyroActionPreference
        android:key="about_version"
        android:selectable="false"
        android:title="@string/zyro_about"/>

    <net.kdt.pojavlaunch.prefs.ZyroActionPreference
        android:key="about_source"
        android:summary="https://github.com/JIGNESH01-ai/Zyrocraft-launcher"
        android:title="@string/zyro_open_folder"
        app:zyroActionText="@string/zyro_action_open"/>

</PreferenceScreen>
