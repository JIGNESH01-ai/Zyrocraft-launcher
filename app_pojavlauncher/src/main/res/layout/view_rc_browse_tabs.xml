<?xml version="1.0" encoding="utf-8"?>
<!-- Content tabs shown above the browse screens: modpacks, mods, packs,
     shaders, worlds, vanilla versions and local favorites. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rc_tabs_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fadingEdgeLength="@dimen/_20sdp"
    android:requiresFadingEdge="horizontal"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/rc_tabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_moderate"
        android:paddingEnd="@dimen/padding_small">

        <fr.spse.extended_view.ExtendedTextView
            android:id="@+id/tab_modpacks"
            style="@style/RcTab"
            android:drawableStart="@drawable/ic_rc_layers"
            android:text="@string/rc_tab_modpacks"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_16sdp"/>

        <fr.spse.extended_view.ExtendedTextView
            android:id="@+id/tab_mods"
            style="@style/RcTab"
            android:drawableStart="@drawable/ic_rc_puzzle"
            android:text="@string/rc_tab_mods"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_16sdp"/>

        <fr.spse.extended_view.ExtendedTextView
            android:id="@+id/tab_resource_packs"
            style="@style/RcTab"
            android:drawableStart="@drawable/ic_rc_image"
            android:text="@string/rc_resource_packs"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_16sdp"/>

        <fr.spse.extended_view.ExtendedTextView
            android:id="@+id/tab_shaders"
            style="@style/RcTab"
            android:drawableStart="@drawable/ic_rc_sparkle"
            android:text="@string/rc_shaders"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_16sdp"/>

        <fr.spse.extended_view.ExtendedTextView
            android:id="@+id/tab_worlds"
            style="@style/RcTab"
            android:drawableStart="@drawable/ic_rc_blocks"
            android:text="@string/rc_tab_worlds"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_16sdp"/>

        <fr.spse.extended_view.ExtendedTextView
            android:id="@+id/tab_vanilla"
            style="@style/RcTab"
            android:drawableStart="@drawable/ic_rc_java"
            android:text="@string/rc_tab_install_vanilla"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_16sdp"/>

        <fr.spse.extended_view.ExtendedTextView
            android:id="@+id/tab_favorites"
            style="@style/RcTab"
            android:drawableStart="@drawable/ic_rc_heart_outline"
            android:text="@string/rc_tab_favorites"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_16sdp"/>

    </LinearLayout>
</HorizontalScrollView>
