<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_medium"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/rc_panel"
    android:paddingHorizontal="@dimen/padding_heavy"
    android:paddingVertical="@dimen/padding_medium">

    <ImageView
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:src="@drawable/ic_rc_cube"
        android:importantForAccessibility="no"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/padding_heavy"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rc_version_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rc_text_primary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/rc_version_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rc_text_secondary"
            android:textSize="@dimen/_9ssp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/rc_version_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rc_badge_purple"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:paddingVertical="@dimen/padding_small"
        android:textColor="@color/rc_purple"
        android:textSize="@dimen/_9ssp"
        android:layout_marginEnd="@dimen/padding_heavy"/>

    <Button
        android:id="@+id/rc_version_install"
        style="@style/RcButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_32sdp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:text="@string/rc_install"
        android:textSize="@dimen/_10ssp"/>
</LinearLayout>
