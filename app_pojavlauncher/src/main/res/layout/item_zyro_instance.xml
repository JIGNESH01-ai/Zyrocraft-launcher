<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_heavy"
    android:orientation="vertical"
    android:background="@drawable/zyro_panel_ripple"
    android:padding="@dimen/padding_heavy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/zyro_instance_icon"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/zyro_avatar_frame"
            android:padding="@dimen/padding_small"
            android:scaleType="fitCenter"
            android:contentDescription="@string/zyro_instances"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/padding_heavy"
            android:orientation="vertical">

            <TextView
                android:id="@+id/zyro_instance_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/zyro_text_primary"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/zyro_instance_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/zyro_text_secondary"
                android:textSize="@dimen/_10ssp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/zyro_instance_loader_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/zyro_badge_purple"
            android:paddingHorizontal="@dimen/padding_heavy"
            android:paddingVertical="@dimen/padding_small"
            android:textColor="@color/zyro_purple"
            android:textSize="@dimen/_9ssp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_heavy"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/zyro_instance_play"
            style="@style/ZyroButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/padding_extra_large"
            android:text="@string/zyro_instance_play"
            android:textSize="@dimen/_11ssp"/>

        <Button
            android:id="@+id/zyro_instance_edit"
            style="@style/ZyroButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/padding_heavy"
            android:text="@string/zyro_edit"
            android:textSize="@dimen/_11ssp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/zyro_instance_duplicate"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:background="@drawable/zyro_btn_secondary"
            android:padding="@dimen/padding_medium"
            android:src="@drawable/ic_zyro_copy"
            app:tint="@color/zyro_neon"
            android:contentDescription="@string/zyro_duplicate"/>

        <ImageButton
            android:id="@+id/zyro_instance_delete"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:background="@drawable/zyro_btn_danger"
            android:padding="@dimen/padding_medium"
            android:src="@drawable/ic_zyro_trash"
            app:tint="@color/zyro_danger"
            android:contentDescription="@string/instance_delete"/>
    </LinearLayout>
</LinearLayout>
