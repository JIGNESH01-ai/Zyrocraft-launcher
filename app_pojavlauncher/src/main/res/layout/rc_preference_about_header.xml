<?xml version="1.0" encoding="utf-8"?>
<!-- About tab header: the launcher logo on its own card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/rc_settings_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/_16sdp"
    android:paddingTop="@dimen/_16sdp"
    android:paddingEnd="@dimen/_16sdp"
    android:paddingBottom="@dimen/_16sdp">

    <ImageView
        android:id="@+id/rc_about_logo"
        android:layout_width="@dimen/_96sdp"
        android:layout_height="@dimen/_96sdp"
        android:contentDescription="@string/rc_brand_full"
        android:src="@drawable/rc_logo"/>

    <TextView
        android:id="@+id/rc_about_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/noto_sans_bold"
        android:letterSpacing="0.12"
        android:text="@string/rc_brand_full"
        android:textColor="@color/rc_text_primary"
        android:textSize="@dimen/_14ssp"/>

    <TextView
        android:id="@+id/rc_about_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:text="@string/rc_tagline"
        android:textColor="@color/rc_text_secondary"
        android:textSize="@dimen/_10ssp"/>

</LinearLayout>
