<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_moderate"
    android:background="@drawable/rc_panel_ripple"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/padding_heavy">

    <ImageView
        android:id="@+id/world_icon"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/rc_avatar_frame"
        android:contentDescription="@string/rc_tab_worlds"
        android:padding="@dimen/padding_small"
        android:scaleType="centerCrop"
        app:srcCompat="@mipmap/ic_launcher"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_heavy"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/world_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rc_text_primary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            tools:text="New World"/>

        <TextView
            android:id="@+id/world_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rc_text_secondary"
            android:textSize="@dimen/_9ssp"
            tools:text="Last played 2026-10-20"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/world_open"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:background="@drawable/rc_pager_bg"
        android:contentDescription="@string/rc_world_open"
        android:padding="@dimen/padding_moderate"
        android:src="@drawable/ic_rc_folder"
        app:tint="@color/rc_neon"/>

    <ImageButton
        android:id="@+id/world_delete"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/padding_small"
        android:background="@drawable/rc_pager_bg"
        android:contentDescription="@string/rc_world_delete"
        android:padding="@dimen/padding_moderate"
        android:src="@drawable/ic_rc_trash"
        app:tint="@color/rc_danger"/>

</LinearLayout>
