<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/padding_heavy">

    <TextView
        android:id="@+id/zyro_packs_title"
        style="@style/ZyroTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_heavy"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zyro_packs_import"/>

    <TextView
        android:id="@+id/zyro_packs_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_medium"
        android:text="@string/zyro_rp_info"
        app:layout_constraintTop_toBottomOf="@id/zyro_packs_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zyro_packs_import"
        style="@style/ZyroSubtitle"/>

    <Button
        android:id="@+id/zyro_packs_import"
        style="@style/ZyroButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_36sdp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:textSize="@dimen/_10ssp"
        android:text="@string/zyro_pack_import"
        app:layout_constraintTop_toTopOf="@id/zyro_packs_title"
        app:layout_constraintBottom_toBottomOf="@id/zyro_packs_title"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/zyro_packs_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_medium"
        android:background="@drawable/zyro_panel_purple"
        android:padding="@dimen/padding_heavy"
        android:text="@string/zyro_shader_warning"
        android:textColor="@color/zyro_purple"
        android:textSize="@dimen/_9ssp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/zyro_packs_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <HorizontalScrollView
        android:id="@+id/zyro_packs_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_medium"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/zyro_packs_warning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/tab_all" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zyro_filter_all"/>
            <Button android:id="@+id/tab_enabled" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/padding_medium" android:text="@string/zyro_tab_enabled"/>
            <Button android:id="@+id/tab_disabled" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/padding_medium" android:text="@string/zyro_tab_disabled"/>
            <Button android:id="@+id/tab_open_folder" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/padding_medium" android:text="@string/zyro_open_folder"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/zyro_packs_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/padding_medium"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/padding_large"
        app:layout_constraintTop_toBottomOf="@id/zyro_packs_tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/zyro_packs_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/zyro_text_secondary"
        android:textSize="@dimen/_12ssp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/zyro_packs_list"
        app:layout_constraintBottom_toBottomOf="@id/zyro_packs_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
