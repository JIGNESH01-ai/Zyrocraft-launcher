<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row: title and description on the left, chevron on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/rc_settings_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_60sdp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_16sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_16sdp"
    android:paddingBottom="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_bold"
            android:textColor="@color/rc_text_primary"
            android:textSize="@dimen/_14ssp"
            tools:text="Verify game files"/>

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textColor="@color/rc_text_secondary"
            android:textSize="@dimen/_10ssp"
            tools:text="Check the downloaded game files against the metadata"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/rc_pref_widget"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:contentDescription="@null"
        android:src="@drawable/ic_rc_chevron_right"
        android:tint="@color/rc_text_secondary"/>

</LinearLayout>
