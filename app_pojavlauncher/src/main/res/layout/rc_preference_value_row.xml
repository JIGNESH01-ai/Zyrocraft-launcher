<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row whose right side shows the current value in a pill -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/rc_settings_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_60sdp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_16sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_16sdp"
    android:paddingBottom="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_bold"
            android:textColor="@color/rc_text_primary"
            android:textSize="@dimen/_14ssp"
            tools:text="Renderer"/>

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textColor="@color/rc_text_secondary"
            android:textSize="@dimen/_10ssp"
            tools:text="Select the renderer used by the game"/>
    </LinearLayout>

    <TextView
        android:id="@+id/rc_pref_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:background="@drawable/rc_value_pill"
        android:fontFamily="@font/noto_sans_bold"
        android:gravity="center"
        android:maxWidth="@dimen/_120sdp"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_6sdp"
        android:textColor="@color/rc_accent"
        android:textSize="@dimen/_11ssp"
        tools:text="Holy GL4ES"/>

</LinearLayout>
