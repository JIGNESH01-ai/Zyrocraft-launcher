<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/padding_heavy">

    <TextView
        android:id="@+id/zyro_versions_title"
        style="@style/ZyroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_heavy"
        android:text="@string/zyro_versions"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_medium"
        android:text="@string/zyro_versions_subtitle"
        app:layout_constraintTop_toBottomOf="@id/zyro_versions_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zyro_versions_refresh"
        style="@style/ZyroSubtitle"/>

    <Button
        android:id="@+id/zyro_versions_refresh"
        style="@style/ZyroButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_36sdp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:text="@string/zyro_refresh_versions"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintTop_toTopOf="@id/zyro_versions_title"
        app:layout_constraintBottom_toBottomOf="@id/zyro_versions_title"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/zyro_versions_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_heavy"
        android:background="@drawable/zyro_edittext_bg"
        android:hint="@string/zyro_search_versions"
        android:inputType="text"
        android:textColorHint="@color/zyro_text_secondary"
        android:textColor="@color/zyro_text_primary"
        android:textSize="@dimen/_11ssp"
        android:singleLine="true"
        android:drawableEnd="@drawable/ic_zyro_search"
        android:drawableTint="@color/zyro_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/zyro_versions_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <HorizontalScrollView
        android:id="@+id/zyro_versions_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_medium"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/zyro_versions_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/tab_all" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zyro_filter_all"/>
            <Button android:id="@+id/tab_release" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/padding_medium" android:text="@string/zyro_tab_release"/>
            <Button android:id="@+id/tab_snapshot" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/padding_medium" android:text="@string/zyro_tab_snapshot"/>
            <Button android:id="@+id/tab_modded" style="@style/ZyroChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/padding_medium" android:text="@string/zyro_tab_modded"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/zyro_versions_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/padding_medium"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/padding_large"
        app:layout_constraintTop_toBottomOf="@id/zyro_versions_tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/zyro_modded_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/zyro_versions_tabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:text="@string/zyro_modded_subtitle"
            style="@style/ZyroSubtitle"/>

        <Button
            android:id="@+id/zyro_modded_open"
            style="@style/ZyroButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginTop="@dimen/padding_heavy"
            android:text="@string/zyro_create_instance"/>
    </LinearLayout>

    <TextView
        android:id="@+id/zyro_versions_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/zyro_text_secondary"
        android:textSize="@dimen/_12ssp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/zyro_versions_list"
        app:layout_constraintBottom_toBottomOf="@id/zyro_versions_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/zyro_versions_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/zyro_neon"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/zyro_versions_list"
        app:layout_constraintBottom_toBottomOf="@id/zyro_versions_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
