<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/fragment_menu_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@android:color/transparent">

	<ScrollView
		android:id="@+id/home_scroll"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:scrollbars="none"
		android:fillViewport="true"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toTopOf="@id/home_bottom_bar">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="@dimen/padding_heavy"
			android:paddingTop="@dimen/padding_heavy"
			android:paddingBottom="@dimen/padding_large">

			<!-- HERO -->
			<FrameLayout
				android:layout_width="match_parent"
				android:layout_height="@dimen/_170sdp">

				<ImageView
					android:id="@+id/home_hero_image"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:scaleType="centerCrop"
					android:src="@drawable/rc_hero_bg"
					android:background="@drawable/rc_hero_round"
					android:clipToOutline="true"
					android:contentDescription="@string/rc_tagline"/>

				<View
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/rc_hero_scrim"/>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_gravity="bottom"
					android:orientation="vertical"
					android:padding="@dimen/padding_heavy">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/rc_welcome"
						android:textColor="@color/rc_text_secondary"
						android:textSize="@dimen/_12ssp"/>

					<TextView
						android:id="@+id/home_player_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Player"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_22ssp"
						android:textStyle="bold"
						android:fontFamily="@font/noto_sans_bold"
						tools:text="Player"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_small"
						android:text="@string/rc_tagline"
						android:textColor="@color/rc_neon"
						android:textSize="@dimen/_11ssp"/>
				</LinearLayout>
			</FrameLayout>

			<!-- SELECTED INSTANCE CARD -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/padding_heavy"
				android:orientation="vertical"
				android:background="@drawable/rc_panel_ripple"
				android:padding="@dimen/padding_heavy">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:gravity="center_vertical">

					<ImageView
						android:id="@+id/home_instance_avatar"
						android:layout_width="@dimen/_44sdp"
						android:layout_height="@dimen/_44sdp"
						android:background="@drawable/rc_avatar_frame"
						android:padding="@dimen/padding_small"
						android:scaleType="fitCenter"
						android:contentDescription="@string/rc_instances"
						tools:src="@mipmap/ic_launcher"/>

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="@dimen/padding_heavy"
						android:orientation="vertical">

						<TextView
							android:id="@+id/home_instance_name"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="@color/rc_text_primary"
							android:textSize="@dimen/_14ssp"
							android:textStyle="bold"
							android:text="@string/rc_filter_all"
							tools:text="Default"/>

						<LinearLayout
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:orientation="horizontal"
							android:gravity="center_vertical">

							<View
								android:layout_width="@dimen/_6sdp"
								android:layout_height="@dimen/_6sdp"
								android:background="@drawable/rc_badge_bg"/>

							<TextView
								android:id="@+id/home_instance_status"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginStart="@dimen/padding_medium"
								android:textColor="@color/rc_text_secondary"
								android:textSize="@dimen/_10ssp"
								android:text="@string/rc_installed"
								tools:text="Offline Profile"/>
						</LinearLayout>
					</LinearLayout>

					<Button
						android:id="@+id/change_instance_button"
						style="@style/RcButton.Secondary"
						android:layout_width="wrap_content"
						android:layout_height="@dimen/_32sdp"
						android:minWidth="0dp"
						android:minHeight="0dp"
						android:paddingHorizontal="@dimen/padding_heavy"
						android:text="@string/rc_change"
						android:textSize="@dimen/_10ssp"/>
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="@dimen/_1sdp"
					android:layout_marginVertical="@dimen/padding_heavy"
					android:background="@color/rc_stroke"/>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:gravity="center_vertical">

					<ImageView
						android:layout_width="@dimen/_16sdp"
						android:layout_height="@dimen/_16sdp"
						android:src="@drawable/ic_rc_blocks"
						app:tint="@color/rc_purple"
						android:contentDescription="@string/rc_versions"/>

					<TextView
						android:id="@+id/home_instance_version_text"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="@dimen/padding_medium"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_11ssp"
						tools:text="Minecraft 1.20.4"/>

					<TextView
						android:id="@+id/home_instance_loader_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/rc_badge_purple"
						android:paddingHorizontal="@dimen/padding_heavy"
						android:paddingVertical="@dimen/padding_small"
						android:textColor="@color/rc_purple"
						android:textSize="@dimen/_9ssp"
						android:text="@string/rc_filter_vanilla"
						tools:text="Forge 49.1.0"/>
				</LinearLayout>
			</LinearLayout>

			<!-- QUICK ACCESS -->
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/padding_extra_large"
				android:layout_marginBottom="@dimen/padding_heavy"
				android:text="@string/rc_quick_access"
				android:textColor="@color/rc_text_primary"
				android:textSize="@dimen/_15ssp"
				android:textStyle="bold"
				android:fontFamily="@font/noto_sans_bold"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">

				<LinearLayout
					android:id="@+id/card_instances"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/padding_medium"
					android:orientation="vertical"
					android:background="@drawable/rc_panel_ripple"
					android:padding="@dimen/padding_heavy">

					<ImageView
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:src="@drawable/ic_rc_cube"
						app:tint="@color/rc_neon"
						android:contentDescription="@string/rc_instances"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_medium"
						android:text="@string/rc_instances"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_12ssp"
						android:textStyle="bold"/>

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_tiny"
						android:text="@string/rc_manage_instances"
						android:textColor="@color/rc_text_secondary"
						android:textSize="@dimen/_9ssp"
						android:maxLines="2"
						android:ellipsize="end"/>
				</LinearLayout>

				<LinearLayout
					android:id="@+id/card_mods"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/padding_medium"
					android:orientation="vertical"
					android:background="@drawable/rc_panel_ripple"
					android:padding="@dimen/padding_heavy">

					<ImageView
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:src="@drawable/ic_rc_puzzle"
						app:tint="@color/rc_purple"
						android:contentDescription="@string/rc_mods"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_medium"
						android:text="@string/rc_mods"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_12ssp"
						android:textStyle="bold"/>

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_tiny"
						android:text="@string/rc_browse_mods"
						android:textColor="@color/rc_text_secondary"
						android:textSize="@dimen/_9ssp"
						android:maxLines="2"
						android:ellipsize="end"/>
				</LinearLayout>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/padding_heavy"
				android:orientation="horizontal">

				<LinearLayout
					android:id="@+id/card_modpacks"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/padding_medium"
					android:orientation="vertical"
					android:background="@drawable/rc_panel_ripple"
					android:padding="@dimen/padding_heavy">

					<ImageView
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:src="@drawable/ic_rc_layers"
						app:tint="@color/rc_neon"
						android:contentDescription="@string/rc_modpacks"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_medium"
						android:text="@string/rc_modpacks"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_12ssp"
						android:textStyle="bold"/>

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_tiny"
						android:text="@string/rc_play_modpacks"
						android:textColor="@color/rc_text_secondary"
						android:textSize="@dimen/_9ssp"
						android:maxLines="2"
						android:ellipsize="end"/>
				</LinearLayout>

				<LinearLayout
					android:id="@+id/card_resource_packs"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/padding_medium"
					android:orientation="vertical"
					android:background="@drawable/rc_panel_ripple"
					android:padding="@dimen/padding_heavy">

					<ImageView
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:src="@drawable/ic_rc_image"
						app:tint="@color/rc_purple"
						android:contentDescription="@string/rc_resource_packs"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_medium"
						android:text="@string/rc_resource_packs"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_12ssp"
						android:textStyle="bold"/>

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_tiny"
						android:text="@string/rc_customize_world"
						android:textColor="@color/rc_text_secondary"
						android:textSize="@dimen/_9ssp"
						android:maxLines="2"
						android:ellipsize="end"/>
				</LinearLayout>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/padding_heavy"
				android:orientation="horizontal">

				<LinearLayout
					android:id="@+id/card_shaders"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/padding_medium"
					android:orientation="vertical"
					android:background="@drawable/rc_panel_ripple"
					android:padding="@dimen/padding_heavy">

					<ImageView
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:src="@drawable/ic_rc_sparkle"
						app:tint="@color/rc_neon"
						android:contentDescription="@string/rc_shaders"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_medium"
						android:text="@string/rc_shaders"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_12ssp"
						android:textStyle="bold"/>

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_tiny"
						android:text="@string/rc_enhance_visuals"
						android:textColor="@color/rc_text_secondary"
						android:textSize="@dimen/_9ssp"
						android:maxLines="2"
						android:ellipsize="end"/>
				</LinearLayout>

				<LinearLayout
					android:id="@+id/card_downloads"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/padding_medium"
					android:orientation="vertical"
					android:background="@drawable/rc_panel_ripple"
					android:padding="@dimen/padding_heavy">

					<ImageView
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:src="@drawable/ic_rc_download"
						app:tint="@color/rc_purple"
						android:contentDescription="@string/rc_downloads"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_medium"
						android:text="@string/rc_downloads"
						android:textColor="@color/rc_text_primary"
						android:textSize="@dimen/_12ssp"
						android:textStyle="bold"/>

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/padding_tiny"
						android:text="@string/rc_view_downloads"
						android:textColor="@color/rc_text_secondary"
						android:textSize="@dimen/_9ssp"
						android:maxLines="2"
						android:ellipsize="end"/>
				</LinearLayout>
			</LinearLayout>

			<!-- UTILITIES -->
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/padding_extra_large"
				android:layout_marginBottom="@dimen/padding_heavy"
				android:text="@string/rc_utilities"
				android:textColor="@color/rc_text_primary"
				android:textSize="@dimen/_15ssp"
				android:textStyle="bold"
				android:fontFamily="@font/noto_sans_bold"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/custom_control_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="@dimen/_48sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/padding_medium"
					android:text="@string/mcl_option_customcontrol"
					android:textSize="@dimen/_10ssp"
					android:drawableStart="@drawable/ic_px_gamepad"
					android:drawablePadding="@dimen/padding_medium"/>

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/install_jar_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="@dimen/_48sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/padding_medium"
					android:text="@string/main_install_jar_file"
					android:textSize="@dimen/_10ssp"
					android:drawableStart="@drawable/ic_px_java_run"
					android:drawablePadding="@dimen/padding_medium"/>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/padding_medium"
				android:orientation="horizontal">

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/share_logs_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="@dimen/_48sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/padding_medium"
					android:text="@string/main_share_logs"
					android:textSize="@dimen/_10ssp"
					android:drawableStart="@drawable/ic_px_sharelog"
					android:drawablePadding="@dimen/padding_medium"/>

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/open_files_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="@dimen/_48sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/padding_medium"
					android:text="@string/mcl_button_open_directory"
					android:textSize="@dimen/_10ssp"
					android:drawableStart="@drawable/ic_px_folder"
					android:drawablePadding="@dimen/padding_medium"/>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/padding_medium"
				android:orientation="horizontal">

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/news_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="@dimen/_48sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/padding_medium"
					android:text="@string/mcl_tab_wiki"
					android:textSize="@dimen/_10ssp"
					android:drawableStart="@drawable/ic_px_book"
					android:drawablePadding="@dimen/padding_medium"/>

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/social_media_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="@dimen/_48sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/padding_medium"
					android:text="@string/mcl_button_social_media"
					android:textSize="@dimen/_10ssp"
					android:drawableStart="@drawable/ic_social_media"
					android:drawablePadding="@dimen/padding_medium"/>
			</LinearLayout>

		</LinearLayout>
	</ScrollView>

	<!-- FIXED BOTTOM: instance switcher + PLAY -->
	<LinearLayout
		android:id="@+id/home_bottom_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="@drawable/rc_panel_accent"
		android:paddingHorizontal="@dimen/padding_heavy"
		android:paddingTop="@dimen/padding_heavy"
		android:paddingBottom="@dimen/padding_large"
		app:layout_constraintBottom_toBottomOf="parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="@dimen/_44sdp"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<ImageView
				android:layout_width="@dimen/_18sdp"
				android:layout_height="@dimen/_18sdp"
				android:src="@drawable/ic_rc_cube"
				app:tint="@color/rc_neon"
				android:contentDescription="@string/rc_instances"/>

			<com.kdt.mcgui.mcVersionSpinner
				android:id="@+id/mc_version_spinner"
				android:layout_width="0dp"
				android:layout_height="@dimen/_44sdp"
				android:layout_weight="1"
				android:background="@android:color/transparent"
				android:drawableEnd="@drawable/spinner_arrow"
				app:drawableEndSize="@dimen/padding_heavy"
				app:drawableStartIntegerScaling="true"
				app:drawableEndPadding="@dimen/_1sdp"/>

			<ImageButton
				android:id="@+id/edit_profile_button"
				android:layout_width="@dimen/_44sdp"
				android:layout_height="@dimen/_44sdp"
				android:background="@drawable/rc_btn_secondary"
				android:padding="@dimen/padding_heavy"
				android:src="@drawable/ic_px_edit"
				android:contentDescription="@string/rc_settings"/>
		</LinearLayout>

		<com.kdt.mcgui.MineButton
			android:id="@+id/play_button"
			android:layout_width="match_parent"
			android:layout_height="@dimen/_58sdp"
			android:layout_marginTop="@dimen/padding_medium"
			android:textAllCaps="true"
			android:text="@string/main_play"
			android:textSize="@dimen/_15ssp"/>
	</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
