<?xml version="1.0" encoding="utf-8"?>
<!-- Left navigation rail background: dark panel with a 1dp divider on its right edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zyro_stroke_neon"/>
        </shape>
    </item>
    <item android:right="@dimen/zyro_nav_border">
        <shape android:shape="rectangle">
            <solid android:color="@color/zyro_panel"/>
        </shape>
    </item>
</layer-list>
