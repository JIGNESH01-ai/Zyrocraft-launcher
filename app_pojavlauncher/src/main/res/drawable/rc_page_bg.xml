<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rc_background"/>
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#12232C"
                android:centerColor="#07141A"
                android:endColor="@color/rc_background"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
