<?xml version="1.0" encoding="utf-8"?>
<!-- ZYROCRAFT home screen, landscape. Navigation lives in the left rail (see
     view_zyro_nav_rail.xml), so this screen only shows the player, the selected
     instance and the utility actions. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/home_land_columns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/home_bottom_bar">

        <!-- LEFT: hero + selected instance -->
        <ScrollView
            android:id="@+id/home_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_heavy"
                android:paddingTop="@dimen/padding_heavy"
                android:paddingEnd="@dimen/padding_moderate"
                android:paddingBottom="@dimen/padding_heavy">

                <!-- HERO -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_130sdp">

                    <ImageView
                        android:id="@+id/home_hero_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/zyro_hero_round"
                        android:clipToOutline="true"
                        android:contentDescription="@string/zyro_tagline"
                        android:scaleType="centerCrop"
                        android:src="@drawable/zyro_hero_bg"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/zyro_hero_scrim"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_heavy">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zyro_welcome"
                            android:textColor="@color/zyro_text_secondary"
                            android:textSize="@dimen/_10ssp"/>

                        <TextView
                            android:id="@+id/home_player_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/noto_sans_bold"
                            android:text="Player"
                            android:textColor="@color/zyro_text_primary"
                            android:textSize="@dimen/_18ssp"
                            android:textStyle="bold"
                            tools:text="Player"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_small"
                            android:text="@string/zyro_tagline"
                            android:textColor="@color/zyro_neon"
                            android:textSize="@dimen/_9ssp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- SELECTED INSTANCE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_heavy"
                    android:background="@drawable/zyro_panel_ripple"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_heavy">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/home_instance_avatar"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:background="@drawable/zyro_avatar_frame"
                            android:contentDescription="@string/zyro_instances"
                            android:padding="@dimen/padding_small"
                            android:scaleType="fitCenter"
                            tools:src="@mipmap/ic_launcher"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/padding_heavy"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/home_instance_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zyro_filter_all"
                                android:textColor="@color/zyro_text_primary"
                                android:textSize="@dimen/_12ssp"
                                android:textStyle="bold"
                                tools:text="Default"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="@dimen/_6sdp"
                                    android:layout_height="@dimen/_6sdp"
                                    android:background="@drawable/zyro_badge_bg"/>

                                <TextView
                                    android:id="@+id/home_instance_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/padding_medium"
                                    android:text="@string/zyro_installed"
                                    android:textColor="@color/zyro_text_secondary"
                                    android:textSize="@dimen/_9ssp"
                                    tools:text="Launch Minecraft Java Edition"/>
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/change_instance_button"
                            style="@style/ZyroButton.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_28sdp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="@dimen/padding_heavy"
                            android:paddingEnd="@dimen/padding_heavy"
                            android:text="@string/zyro_change"
                            android:textSize="@dimen/_9ssp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginTop="@dimen/padding_moderate"
                        android:layout_marginBottom="@dimen/padding_moderate"
                        android:background="@color/zyro_stroke"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_14sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:contentDescription="@string/zyro_versions"
                            android:src="@drawable/ic_zyro_blocks"
                            app:tint="@color/zyro_purple"/>

                        <TextView
                            android:id="@+id/home_instance_version_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/padding_medium"
                            android:layout_weight="1"
                            android:textColor="@color/zyro_text_primary"
                            android:textSize="@dimen/_10ssp"
                            tools:text="Minecraft 1.20.4"/>

                        <TextView
                            android:id="@+id/home_instance_loader_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/zyro_badge_purple"
                            android:paddingStart="@dimen/padding_heavy"
                            android:paddingTop="@dimen/padding_small"
                            android:paddingEnd="@dimen/padding_heavy"
                            android:paddingBottom="@dimen/padding_small"
                            android:text="@string/zyro_filter_vanilla"
                            android:textColor="@color/zyro_purple"
                            android:textSize="@dimen/_8ssp"
                            tools:text="Forge 49.1.0"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- RIGHT: utilities -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_moderate"
                android:paddingTop="@dimen/padding_heavy"
                android:paddingEnd="@dimen/padding_heavy"
                android:paddingBottom="@dimen/padding_heavy">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_heavy"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="@string/zyro_utilities"
                    android:textColor="@color/zyro_text_primary"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/custom_control_button"
                        style="@style/LauncherMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_marginEnd="@dimen/padding_medium"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_px_gamepad"
                        android:drawablePadding="@dimen/padding_medium"
                        android:text="@string/mcl_option_customcontrol"
                        android:textSize="@dimen/_9ssp"/>

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/install_jar_button"
                        style="@style/LauncherMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_marginStart="@dimen/padding_medium"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_px_java_run"
                        android:drawablePadding="@dimen/padding_medium"
                        android:text="@string/main_install_jar_file"
                        android:textSize="@dimen/_9ssp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_medium"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/share_logs_button"
                        style="@style/LauncherMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_marginEnd="@dimen/padding_medium"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_px_sharelog"
                        android:drawablePadding="@dimen/padding_medium"
                        android:text="@string/main_share_logs"
                        android:textSize="@dimen/_9ssp"/>

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/open_files_button"
                        style="@style/LauncherMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_marginStart="@dimen/padding_medium"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_px_folder"
                        android:drawablePadding="@dimen/padding_medium"
                        android:text="@string/mcl_button_open_directory"
                        android:textSize="@dimen/_9ssp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_medium"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/news_button"
                        style="@style/LauncherMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_marginEnd="@dimen/padding_medium"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_px_book"
                        android:drawablePadding="@dimen/padding_medium"
                        android:text="@string/mcl_tab_wiki"
                        android:textSize="@dimen/_9ssp"/>

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/social_media_button"
                        style="@style/LauncherMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_marginStart="@dimen/padding_medium"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_social_media"
                        android:drawablePadding="@dimen/padding_medium"
                        android:text="@string/mcl_button_social_media"
                        android:textSize="@dimen/_9ssp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- FIXED BOTTOM: instance switcher + PLAY -->
    <LinearLayout
        android:id="@+id/home_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/zyro_panel_accent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_heavy"
        android:paddingTop="@dimen/padding_moderate"
        android:paddingEnd="@dimen/padding_heavy"
        android:paddingBottom="@dimen/padding_moderate"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:contentDescription="@string/zyro_instances"
            android:src="@drawable/ic_zyro_cube"
            app:tint="@color/zyro_neon"/>

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/padding_heavy"
            app:drawableStartIntegerScaling="true"/>

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/padding_moderate"
            android:background="@drawable/zyro_btn_secondary"
            android:contentDescription="@string/zyro_settings"
            android:padding="@dimen/padding_heavy"
            android:src="@drawable/ic_px_edit"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginStart="@dimen/padding_heavy"
            android:layout_weight="0.9"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textSize="@dimen/_13ssp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
