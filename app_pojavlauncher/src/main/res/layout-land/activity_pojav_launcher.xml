<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/zyro_page_bg">

    <!-- Navigation lives on the left: every launcher section is one tap away -->
    <include
        layout="@layout/view_zyro_nav_rail"
        android:layout_width="@dimen/zyro_nav_width"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Account switcher, kept on the top right of the content area -->
    <LinearLayout
        android:id="@+id/zyro_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:paddingVertical="@dimen/padding_moderate"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/zyro_nav_rail"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/zyro_screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/noto_sans_bold"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/zyro_home"
            android:textColor="@color/zyro_text_primary"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"/>

        <com.kdt.mcgui.AccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/zyro_avatar_frame"
            android:dropDownWidth="@dimen/_250sdp"
            android:dropDownVerticalOffset="@dimen/_44sdp"
            android:paddingEnd="@dimen/_8sdp"
            tools:ignore="RtlSymmetry"/>
    </LinearLayout>

    <!-- Holding most of the dynamic content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@+id/zyro_top_bar"
        app:layout_constraintStart_toEndOf="@id/zyro_nav_rail"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/zyro_panel_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/zyro_nav_rail"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
