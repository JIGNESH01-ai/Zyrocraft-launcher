<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="MojoLauncher" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/rc_page_bg</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/RcPreferenceTheme</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">@color/rc_text_primary</item>
        <item name="dialogCornerRadius">12dp</item>
        <item name="android:seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="android:switchStyle">@style/MojoLauncher.Switch</item>
        <item name="switchStyle">@style/MojoLauncher.Switch</item>
        <item name="buttonStyle">@style/MojoLauncher.Button</item>
        <item name="android:buttonStyleToggle">@style/MojoLauncher.Button.Toggle</item>
    </style>

    <style name="MojoLauncher.AppTheme" parent="MojoLauncher"/>

    <style name="MojoLauncher.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/rc_progress</item>
        <item name="android:thumb">@drawable/mineknob_on_unfiltered</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
    </style>

    <style name="MojoLauncher.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/mineknob_track_mask_unfiltered</item>
        <item name="trackTint">@color/mineknob_track_tint</item>
        <item name="trackTintMode">multiply</item>
        <item name="android:thumb">@drawable/mineknob_switch</item>
        <item name="switchMinWidth">40dp</item>
    </style>

    <style name="MojoLauncher.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_flat</item>
        <item name="android:textColor">@color/rc_text_primary</item>
    </style>

    <style name="MojoLauncher.Button.Toggle" parent="MojoLauncher.Button">
        <item name="android:background">@drawable/button_flat_toggle</item>
    </style>


    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/rc_btn_secondary</item>
        <item name="android:textColor">@color/rc_text_primary</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Left navigation rail: one icon button per destination -->
    <style name="RcNavIcon">
        <item name="android:layout_width">@dimen/rc_nav_icon_size</item>
        <item name="android:layout_height">@dimen/rc_nav_icon_size</item>
        <item name="android:layout_marginBottom">@dimen/padding_medium</item>
        <item name="android:background">@drawable/rc_nav_icon_bg</item>
        <item name="android:padding">@dimen/padding_heavy</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:tint">@color/rc_text_secondary</item>
    </style>

    <!-- Content tabs above the browse screens -->
    <style name="RcTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/_34sdp</item>
        <item name="android:layout_marginEnd">@dimen/padding_medium</item>
        <item name="android:background">@drawable/rc_tab_bg</item>
        <item name="android:drawablePadding">@dimen/padding_medium</item>
        <item name="android:drawableTint">@color/rc_text_secondary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/padding_heavy</item>
        <item name="android:paddingEnd">@dimen/padding_heavy</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/rc_text_secondary</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Filter dropdown pills on the browse screens -->
    <style name="RcFilterChip" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/rc_chip_bg</item>
        <item name="android:textColor">@color/rc_text_primary</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">@dimen/padding_heavy</item>
        <item name="android:paddingVertical">@dimen/padding_medium</item>
        <item name="android:minHeight">@dimen/_32sdp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- RC typography and component styles -->
    <style name="RcTitle">
        <item name="android:textSize">@dimen/_18ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/rc_text_primary</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
    </style>

    <style name="RcSubtitle">
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">@color/rc_text_secondary</item>
    </style>

    <style name="RcCardTitle">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/rc_text_primary</item>
    </style>

    <style name="RcCaption">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textColor">@color/rc_text_secondary</item>
    </style>

    <style name="RcSectionTitle">
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/rc_neon</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
    </style>

    <style name="RcChip" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/rc_chip_bg</item>
        <item name="android:textColor">@color/rc_chip_text</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:paddingHorizontal">@dimen/padding_heavy</item>
        <item name="android:paddingVertical">@dimen/padding_medium</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="RcButton.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/rc_btn_primary</item>
        <item name="android:textColor">#02140C</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
    </style>

    <style name="RcButton.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/rc_btn_secondary</item>
        <item name="android:textColor">@color/rc_text_primary</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- Settings: one scrollable row of pill tabs -->
    <style name="RcSettingsTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_4sdp</item>
        <item name="android:layout_marginEnd">@dimen/_4sdp</item>
        <item name="android:background">@drawable/rc_settings_tab_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/_14sdp</item>
        <item name="android:paddingTop">@dimen/_8sdp</item>
        <item name="android:paddingEnd">@dimen/_14sdp</item>
        <item name="android:paddingBottom">@dimen/_8sdp</item>
        <item name="android:textColor">@color/rc_settings_tab_text</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <!-- Settings: every preference is a translucent rounded card -->
    <style name="RcPreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceStyle">@style/RcPrefRow</item>
        <item name="dialogPreferenceStyle">@style/RcPrefRow</item>
        <item name="editTextPreferenceStyle">@style/RcPrefRow</item>
        <item name="preferenceCategoryStyle">@style/RcPrefCategory</item>
        <item name="switchPreferenceCompatStyle">@style/RcPrefSwitch</item>
        <item name="seekBarPreferenceStyle">@style/RcPrefSeek</item>
    </style>

    <style name="RcPrefRow">
        <item name="android:layout">@layout/rc_preference_row</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="RcPrefCategory">
        <item name="android:layout">@layout/rc_preference_category</item>
    </style>

    <style name="RcPrefSwitch">
        <item name="android:layout">@layout/rc_preference_switch</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="RcPrefSeek">
        <item name="android:layout">@layout/rc_preference_seekbar</item>
        <item name="iconSpaceReserved">false</item>
    </style>

</resources>
